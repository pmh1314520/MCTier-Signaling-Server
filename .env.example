# MCTier 信令服务器环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env

# 日志级别：error / warn / info / debug / trace
RUST_LOG=info

# 允许连接的最低客户端版本，低于该版本的客户端会被拒绝
MINIMUM_CLIENT_VERSION=3.0.0

# 版本过低时提示给客户端的下载地址
CLIENT_DOWNLOAD_URL=https://mctier.pmhs.top

# 最大并发 WebSocket 连接数，超出后新连接被直接拒绝
MAX_CONNECTIONS=1024

# 用户投稿共享节点的存档文件。服务器会周期性探测这些节点，
# 失效（连续探测不通）超过 1 天的节点自动移除。
# 该路径在 docker-compose 中挂载为命名卷，容器重建后投稿不丢。
COMMUNITY_NODES_FILE=/app/data/community_nodes.json

# 共享节点列表容量上限
COMMUNITY_NODE_CAPACITY=200

# 是否允许把回环/内网/保留地址作为共享节点探测目标。
# 默认 false：服务器只探测公网可路由地址，防止有人借投稿接口
# 让信令服务器去扫描本机或内网端口（SSRF）。
# 仅当信令服务器与 EasyTier 节点部署在同一内网时才需要开成 true，
# 公网部署务必保持 false。
COMMUNITY_NODE_ALLOW_PRIVATE_TARGETS=false

