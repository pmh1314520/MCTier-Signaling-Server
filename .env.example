# MCTier 信令服务器环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env

# 日志级别：error / warn / info / debug / trace
RUST_LOG=info

# 允许连接的最低客户端版本，低于该版本的客户端会被拒绝
MINIMUM_CLIENT_VERSION=2.1.0

# 版本过低时提示给客户端的下载地址
CLIENT_DOWNLOAD_URL=https://github.com/pmh1314520/MCTier/releases

# 以下两项不会被程序读取，仅作备忘：配置 HTTPS/WSS 时，
# 需要把它们手动填进 nginx.conf 和 certbot 申请证书的命令里。
# 详见 README 的“配置 HTTPS/WSS”章节。
# DOMAIN=your-domain.com
# CERTBOT_EMAIL=your-email@example.com
